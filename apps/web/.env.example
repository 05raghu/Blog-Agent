# ==========================================
# Supabase Configuration (Auth & Database)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ==========================================
# LLM Provider (Choose ONE - auto-detects priority: OpenAI > Anthropic > Mock)
# ==========================================

# OpenAI GPT-4o-mini (https://platform.openai.com/account/api-keys)
# OPENAI_API_KEY=sk-proj-...your-key-here...

# OR Anthropic Claude Haiku 4.5 (https://console.anthropic.com/keys)
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# If neither is set, system uses mock mode (deterministic responses for testing)
